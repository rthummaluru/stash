{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stash",
  "version": "0.1.0",
  "identifier": "v1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "stash",
        "width": 800,
        "height": 600
      },
      {
        "label": "test_overlay",
        "title": "test_overlay",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": true,
        "width": 800,
        "height": 600,
        "url": "http://localhost:1420/test_overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
